function update() {
const dist = target - Date.now();
const el = (id) => document.getElementById(id);
if(!el('cdDays')) return;
if(dist < 0) { ['cdDays','cdHours','cdMinutes','cdSeconds'].forEach(i => el(i).innerText = '০'); return; }
el('cdDays').innerText = toBn(Math.floor(dist / 86400000));
el('cdHours').innerText = toBn(Math.floor((dist % 86400000) / 3600000).toString().padStart(2,'0'));
el('cdMinutes').innerText = toBn(Math.floor((dist % 3600000) / 60000).toString().padStart(2,'0'));
el('cdSeconds').innerText = toBn(Math.floor((dist % 60000) / 1000).toString().padStart(2,'0'));
}
update();
window.countdownInterval = setInterval(update, 1000);
}

