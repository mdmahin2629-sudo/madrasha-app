/* ============ PER-USER DATA ============ */
async function loadUserData(uid) {
const snap = await db.ref('users/' + uid).once('value');
const data = snap.val() || {};
amalHistory = data.amal || {};
notes = data.notes || [];
// fallback to localStorage if empty (migration)
if(Object.keys(amalHistory).length === 0) {
amalHistory = JSON.parse(localStorage.getItem('amalHistory') || '{}');
if(Object.keys(amalHistory).length > 0) await db.ref('users/' + uid + '/amal').set(amalHistory);
}
if(notes.length === 0) {
const localNotes = JSON.parse(localStorage.getItem('madrasaNotes') || '[]');
if(localNotes.length > 0) { notes = localNotes; await db.ref('users/' + uid + '/notes').set(notes); }
}
}

async function saveUserAmal() {
if(!currentUser) return;
await db.ref('users/' + currentUser.uid + '/amal').set(amalHistory);
localStorage.setItem('amalHistory', JSON.stringify(amalHistory));
}

async function saveUserNotes() {
if(!currentUser) return;
await db.ref('users/' + currentUser.uid + '/notes').set(notes);
localStorage.setItem('madrasaNotes', JSON.stringify(notes));
}

