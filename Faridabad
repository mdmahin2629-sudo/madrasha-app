});

function renderMainMenu() {
const c = document.getElementById('mainMenuContent');
if(!c) return;
c.innerHTML = '';
Object.values(menuData).sort((a,b) => (a.order||0) - (b.order||0)).forEach(item => {
const hasKids = item.children && Object.keys(item.children).length > 0;
const kidHTML = hasKids ? `<div class="menu-sub-container" id="submenu_${item.id}">${Object.values(item.children).sort((a,b)=>(a.order||0)-(b.order||0)).map(k => `<div class="menu-sub-item" onclick="openMenuItem('${k.id}')"><i class="${k.icon||'fa-solid fa-circle'}" style="color:var(--accent-green);margin-right:8px;"></i>${k.name}</div>`).join('')}</div>` : '';
c.innerHTML += `<div><div class="menu-main-item" onclick="${hasKids ? `toggleSubmenu('${item.id}')` : `openMenuItem('${item.id}')`}"><span><i class="${item.icon||'fa-solid fa-circle'}" style="margin-right:10px;"></i>${item.name}</span>${hasKids ? `<i class="fa-solid fa-chevron-down" id="arrow_${item.id}"></i>` : ''}</div>${kidHTML}</div>`;
});
c.innerHTML += `<div style="margin-top:20px;padding-top:15px;border-top:1px dashed #ccc;"><div onclick="toggleMainMenu();switchPage('admin-page');" style="padding:12px;background:#fef3c7;color:#92400e;border-radius:10px;font-weight:600;cursor:pointer;text-align:center;"><i class="fa-solid fa-user-shield"></i> এডমিন প্যানেল</div></div>`;
}

function toggleSubmenu(id) {
const s = document.getElementById('submenu_' + id);
const a = document.getElementById('arrow_' + id);
if(s) {
const open = s.classList.toggle('open');
if(a) a.style.transform = open ? 'rotate(180deg)' : 'rotate(0deg)';
}
}

function findMenuItem(id) {
if(menuData[id]) return menuData[id];
for(let k in menuData) { if(menuData[k].children && menuData[k].children[id]) return menuData[k].children[id]; }
return null;
}

/* ============ OPEN MENU ITEM (with special routing for known categories) ============ */
function openMenuItem(id) {
const item = findMenuItem(id);
if(!item) return;
toggleMainMenu();

// Special routing: পরিচিতি সাবমেনু
const aboutMap = { '1-1': 'founder', '1-2': 'mutawalli', '1-3': 'principal', '1-4': 'shaikhul_hadith', '1-5': 'mudarris', '1-6': 'staff' };
if(aboutMap[id]) { renderAboutPage(item.name, aboutMap[id]); return; }
if(id === '1') { renderAboutIndex(); return; }

// গ্যালারি
const galMap = { '2-1': 'campus', '2-2': 'education', '2-3': 'dawra', '2-4': 'mahfil', '2-5': 'moments' };
if(galMap[id]) { renderGalleryPage(item.name, galMap[id]); return; }
if(id === '2') { renderGalleryIndex(); return; }

// শিক্ষা কার্যক্রম
const eduMap = { '3-1': 'hifz', '3-2': 'kitab', '3-3': 'najera', '3-4': 'tajweed', '3-5': 'ifta' };
if(eduMap[id]) { renderEducationPage(item.name, eduMap[id]); return; }
if(id === '3') { renderEducationIndex(); return; }

// যোগাযোগ
if(id && id.startsWith('4')) { renderContactPage(id); return; }

// Default: generic menu detail
renderGenericMenuPage(item);
}

function renderGenericMenuPage(item) {
document.getElementById('menuDetailTitle').innerText = item.name;
const c = document.getElementById('menuDetailContent');
let html = '';
if(item.image) html += `<div style="background:var(--card-bg);border-radius:16px;padding:15px;margin-bottom:15px;box-shadow:var(--shadow);"><img src="${item.image}" style="width:100%;border-radius:12px;object-fit:cover;max-height:300px;" onerror="this.src='https://cdn-icons-png.flaticon.com/512/3299/3299935.png'"></div>`;
