function contactCard(icon, title, body, extraBtn) {
let btn = '';
if(extraBtn) btn = `<button onclick="${extraBtn}" style="margin-top:6px;padding:6px 12px;background:var(--light-green);color:var(--primary-green);border:none;border-radius:15px;font-size:.75rem;cursor:pointer;"><i class="fa-solid fa-copy"></i> কপি করুন</button>`;
return `<div class="contact-card"><div class="ico"><i class="fa-solid ${icon}"></i></div><div class="body"><h4>${title}</h4><p>${body}</p>${btn}</div></div>`;
}

function copyAddress(text) {
navigator.clipboard.writeText(text).then(() => alert('✅ কপি হয়েছে'));
}

