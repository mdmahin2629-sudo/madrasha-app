}
}

auth.onAuthStateChanged(async (user) => {
if(user) {
currentUser = user;
// Ensure profile exists
const snap = await db.ref('users/' + user.uid + '/profile').once('value');
let profile = snap.val();
if(!profile) {
profile = { name: user.displayName || (user.isAnonymous ? 'অতিথি' : 'ব্যবহারকারী'), email: user.email || 'guest@local', type: user.isAnonymous ? 'guest' : 'gmail', createdAt: Date.now() };
await db.ref('users/' + user.uid + '/profile').set(profile);
} else if(user.email && !profile.email) {
profile.email = user.email;
db.ref('users/' + user.uid + '/profile').update({ email: user.email });
}
currentUserProfile = profile;
// Update users list for admin
db.ref('users/' + user.uid + '/profile').update({ lastActive: Date.now() });

// Load per-user data
await loadUserData(user.uid);

// Show app
document.getElementById('login-page').classList.remove('active');
document.getElementById('mainApp').classList.remove('hidden');
document.getElementById('userChipName').innerText = profile.name;
initApp();
} else {
currentUser = null;
currentUserProfile = null;
document.getElementById('login-page').classList.add('active');
document.getElementById('mainApp').classList.add('hidden');
}
});

