function openGalleryLightbox(idx) {
const img = currentGalleryImages[idx];
if(!img) return;
const lb = document.createElement('div');
lb.className = 'gallery-lightbox';
lb.innerHTML = `<button class="close-btn" onclick="this.parentElement.remove()"><i class="fa-solid fa-xmark"></i></button>
<button class="nav-btn" style="left:10px;" onclick="navGallery(${idx-1},this.parentElement)"><i class="fa-solid fa-chevron-left"></i></button>
<img src="${img.url}" onerror="this.src='https://cdn-icons-png.flaticon.com/512/3299/3299935.png'">
<button class="nav-btn" style="right:10px;" onclick="navGallery(${idx+1},this.parentElement)"><i class="fa-solid fa-chevron-right"></i></button>
<div class="cap">${img.caption || ''}</div>`;
document.body.appendChild(lb);
}

function navGallery(newIdx, container) {
if(newIdx < 0 || newIdx >= currentGalleryImages.length) return;
const img = currentGalleryImages[newIdx];
const imgEl = container.querySelector('img');
imgEl.src = img.url;
container.querySelector('.cap').innerText = img.caption || '';
container.querySelectorAll('.nav-btn')[0].setAttribute('onclick', `navGallery(${newIdx-1},this.parentElement)`);
container.querySelectorAll('.nav-btn')[1].setAttribute('onclick', `navGallery(${newIdx+1},this.parentElement)`);
}

