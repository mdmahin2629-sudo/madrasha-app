const p = document.getElementById('menuParent').value;
const n = document.getElementById('menuName').value.trim();
const i = document.getElementById('menuIcon').value.trim() || 'fa-solid fa-circle';
const im = document.getElementById('menuImage').value.trim();
const d = document.getElementById('menuDesc').value.trim();
if(!n) return alert('নাম দিন!');
const nid = 'menu_' + Date.now();
if(p === 'main') {
const o = Object.keys(menuData).length + 1;
db.ref('menu_data/' + nid).set({ id: nid, name: n, icon: i, image: im, desc: d, parent: 'main', order: o, children: {} }, (err) => { if(!err) { alert('✅ যোগ!'); resetMenuForm(); } });
} else {
const pi = menuData[p];
if(!pi) return alert('Parent পাওয়া যায়নি!');
const o = pi.children ? Object.keys(pi.children).length + 1 : 1;
db.ref('menu_data/' + p + '/children/' + nid).set({ id: nid, name: n, icon: i, image: im, desc: d, parent: p, order: o, children: {} }, (err) => { if(!err) { alert('✅ যোগ!'); resetMenuForm(); } });
}
}

function editMenuItem(id, pId) {
const item = pId === 'main' ? menuData[id] : (menuData[pId] && menuData[pId].children ? menuData[pId].children[id] : null);
if(!item) return alert('পাওয়া যায়নি');
const n = prompt('নাম:', item.name); if(n === null) return;
const i = prompt('আইকন:', item.icon || 'fa-solid fa-circle'); if(i === null) return;
const im = prompt('ছবি URL:', item.image || ''); if(im === null) return;
const d = prompt('তথ্য:', item.desc || ''); if(d === null) return;
const path = pId === 'main' ? 'menu_data/' + id : 'menu_data/' + pId + '/children/' + id;
db.ref(path).update({ name: n.trim(), icon: i.trim() || 'fa-solid fa-circle', image: im.trim(), desc: d.trim() }, (err) => { if(!err) alert('✅ আপডেট!'); });
}

function deleteMenuItem(id, pId) {
