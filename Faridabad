<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>জামিয়া আরাবিয়া ইমদাদুল উলূম</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Hind+Siliguri:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<style>
:root{--primary-green:#059669;--accent-green:#10b981;--light-green:#d1fae5;--text-dark:#1f2937;--text-light:#ffffff;--bg-color:#f3f4f6;--border-radius:12px;--shadow:0 4px 6px rgba(0,0,0,0.05);--shadow-lg:0 10px 15px rgba(0,0,0,0.1);--card-bg:#ffffff}
body.dark-mode{--primary-green:#10b981;--accent-green:#34d399;--light-green:#064e3b;--text-dark:#f3f4f6;--text-light:#1f2937;--bg-color:#111827;--shadow:0 4px 6px rgba(0,0,0,0.3);--shadow-lg:0 10px 15px rgba(0,0,0,0.5);--card-bg:#1f2937}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
body{font-family:'Hind Siliguri',sans-serif;background-color:var(--bg-color);color:var(--text-dark);line-height:1.6;padding-bottom:80px;transition:background .3s,color .3s}
.hidden{display:none!important}
.header-top{background:linear-gradient(135deg,var(--primary-green),var(--accent-green));color:#fff;padding:46px 18px 14px;text-align:center;border-bottom-left-radius:18px;border-bottom-right-radius:18px;box-shadow:var(--shadow-lg);position:relative;overflow:hidden}
.madrasa-logo{width:68px;height:68px;border-radius:50%;object-fit:cover;border:3px solid rgba(255,255,255,.75);background:#fff;box-shadow:0 3px 8px rgba(0,0,0,.18);margin:0 auto 5px;display:block}
.arabic-calligraphy{max-width:180px;max-height:48px;object-fit:contain;margin:3px auto 4px;display:block;filter:drop-shadow(0 2px 3px rgba(0,0,0,.2))}
.arabic-title{font-family:'Amiri',serif;font-size:1.1rem;margin-bottom:3px;color:#ecfdf5}
.header-top h1{font-size:1.05rem;font-weight:700;margin-bottom:2px;line-height:1.25}
.header-top p{font-size:.75rem;opacity:.92}
.header-menu-btn,.dark-mode-toggle{position:absolute;top:10px;width:38px;height:38px;background:rgba(255,255,255,.25);backdrop-filter:blur(5px);color:#fff;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.05rem;cursor:pointer;z-index:999;border:1px solid rgba(255,255,255,.3)}
.header-menu-btn{left:10px}.dark-mode-toggle{right:10px}
.user-chip{position:absolute;top:56px;right:10px;background:rgba(255,255,255,.2);color:#fff;padding:4px 10px;border-radius:20px;font-size:.7rem;font-weight:600;display:flex;align-items:center;gap:5px;cursor:pointer;border:1px solid rgba(255,255,255,.3);z-index:999}
.date-bar{text-align:center;font-size:.85rem;color:var(--text-dark);margin:12px 20px;font-weight:600;background:var(--card-bg);padding:9px;border-radius:12px;box-shadow:var(--shadow)}
.menu-drawer{position:fixed;top:0;left:0;width:100%;height:100vh;background:rgba(0,0,0,.55);z-index:9998;overflow:hidden}
.menu-drawer-content{background:var(--card-bg);width:88%;max-width:360px;height:100vh;overflow-y:auto;padding:20px;box-shadow:var(--shadow-lg)}
.menu-drawer-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;padding-bottom:12px;border-bottom:2px solid var(--light-green)}
.menu-drawer-header h3{color:var(--primary-green);font-size:1.1rem}
.menu-close-btn{background:#dc2626;color:#fff;border:none;width:34px;height:34px;border-radius:50%;font-size:.95rem;cursor:pointer}
.menu-main-item{display:flex;align-items:center;justify-content:space-between;padding:12px 15px;background:linear-gradient(135deg,var(--primary-green),var(--accent-green));color:#fff;border-radius:10px;font-weight:600;cursor:pointer;margin-bottom:6px;font-size:.88rem}
.menu-sub-item{padding:10px 14px;margin:4px 0 4px 15px;background:var(--bg-color);border-radius:8px;cursor:pointer;font-size:.83rem;color:var(--text-dark);border-left:3px solid var(--accent-green)}
.menu-sub-container{display:none;margin-bottom:4px}
.menu-sub-container.open{display:block}
.page-content{display:none;padding:0 20px}
.page-content.active{display:block;animation:fadeIn .3s ease}
@keyframes fadeIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
.section-title{font-size:1.1rem;font-weight:700;color:var(--primary-green);margin:20px 0 12px;display:flex;align-items:center;gap:8px}
.grid-container{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
.grid-4-col{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}
.feature-card{background:var(--card-bg);border-radius:var(--border-radius);padding:15px 5px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:8px;box-shadow:var(--shadow);cursor:pointer;border:1px solid rgba(0,0,0,.05)}
.feature-card:active{transform:scale(.95)}
.feature-card i{font-size:1.5rem;color:var(--accent-green)}
.feature-card span{font-size:.75rem;font-weight:600;color:var(--text-dark)}
.main-card{padding:20px 10px}.main-card i{font-size:2rem}.main-card span{font-size:.85rem}
.form-box,.filter-section{background:var(--card-bg);padding:15px;border-radius:var(--border-radius);box-shadow:var(--shadow);margin-bottom:15px}
.form-group{margin-bottom:12px}
.form-group label{font-size:.85rem;font-weight:600;display:block;margin-bottom:5px;color:var(--primary-green)}
.form-group input,.form-group select,.form-group textarea,.filter-select{width:100%;padding:12px;border-radius:10px;border:1px solid #d1d5db;background-color:var(--bg-color);font-family:'Hind Siliguri',sans-serif;font-size:.9rem;outline:none;color:var(--text-dark)}
.form-group input:focus,.form-group select:focus,.form-group textarea:focus{border-color:var(--accent-green);background:var(--card-bg)}
.btn-primary{width:100%;background:linear-gradient(135deg,var(--primary-green),var(--accent-green));color:#fff;border:none;padding:12px;border-radius:10px;font-weight:600;font-size:.95rem;cursor:pointer;font-family:'Hind Siliguri',sans-serif}
.btn-primary:active{transform:scale(.98)}
.btn-danger{background:#dc2626!important}.btn-warning{background:#d97706!important}.btn-info{background:#2563eb!important}
.btn-sm{padding:6px 12px;font-size:.8rem;width:auto}
.back-btn{background:var(--card-bg);border:none;padding:8px 15px;border-radius:20px;font-size:.85rem;font-weight:600;color:var(--primary-green);box-shadow:var(--shadow);cursor:pointer;margin-bottom:15px;display:inline-flex;align-items:center;gap:5px;font-family:'Hind Siliguri',sans-serif}
.student-list{display:flex;flex-direction:column;gap:12px}
.student-card{background:var(--card-bg);border-radius:var(--border-radius);padding:15px;display:flex;flex-direction:column;gap:10px;box-shadow:var(--shadow);border-left:4px solid var(--accent-green)}
.student-header{display:flex;align-items:center;gap:15px;border-bottom:1px dashed #e5e7eb;padding-bottom:10px}
.student-img{width:65px;height:65px;border-radius:50%;object-fit:cover;border:3px solid var(--light-green)}
.student-info{flex:1}.student-info h4{color:var(--primary-green);font-size:1.05rem;margin-bottom:3px}
.student-info p{font-size:.8rem;color:#6b7280;margin-bottom:2px;display:flex;align-items:center;gap:5px}
.student-bio{font-size:.85rem;color:#4b5563;font-style:italic;padding:8px;line-height:1.5;background:var(--bg-color);border-radius:8px;border-left:3px solid var(--accent-green)}
.social-btns{display:flex;gap:8px;margin-top:6px}
.social-btns a{width:32px;height:32px;border-radius:50%;background:var(--light-green);color:var(--primary-green);display:flex;align-items:center;justify-content:center;text-decoration:none;font-size:.9rem}
.ad-card{background:linear-gradient(135deg,#fff,#f0fdf4);border-radius:16px;padding:18px;box-shadow:0 8px 20px rgba(5,150,105,.15);border:1px solid var(--light-green);position:relative;overflow:hidden;margin-bottom:15px}
.ad-card::before{content:'';position:absolute;top:0;left:0;width:5px;height:100%;background:linear-gradient(to bottom,var(--primary-green),var(--accent-green))}
.ad-badge{display:inline-flex;align-items:center;gap:6px;background:var(--primary-green);color:#fff;padding:4px 12px;border-radius:20px;font-size:.75rem;font-weight:700;margin-bottom:10px}
.ad-text{font-size:.9rem;color:var(--text-dark);line-height:1.6;margin-bottom:15px;font-weight:500}
.countdown-label{font-size:.8rem;font-weight:700;color:var(--primary-green);margin-bottom:8px}
.countdown-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
.countdown-item{background:var(--card-bg);border-radius:10px;padding:8px 4px;text-align:center;box-shadow:0 3px 8px rgba(0,0,0,.06);border:1px solid #e5e7eb}
.countdown-item .number{font-size:1.2rem;font-weight:800;color:var(--primary-green)}
.countdown-item .label{font-size:.65rem;color:#6b7280;font-weight:600}
body.dark-mode .ad-card{background:linear-gradient(135deg,#1f2937,#111827)}
body.dark-mode .countdown-item{background:#374151;border-color:#4b5563}
.widget-box{background:var(--card-bg);border-radius:18px;padding:16px;margin:0 0 18px;box-shadow:var(--shadow);border-top:4px solid var(--accent-green)}
.widget-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}
.widget-date-bn{font-size:.85rem;font-weight:700;color:var(--primary-green)}
.widget-date-ar{font-family:'Amiri',serif;font-size:1.05rem;color:var(--accent-green)}
.widget-namaz-row{display:flex;gap:4px;margin-bottom:10px;overflow-x:auto;scrollbar-width:none}
.widget-namaz-row::-webkit-scrollbar{display:none}
.widget-namaz-item{flex:1;min-width:55px;text-align:center;padding:8px 4px;border-radius:10px;background:var(--bg-color);transition:all .3s}
.widget-namaz-item.active{background:linear-gradient(135deg,var(--primary-green),var(--accent-green));color:#fff;transform:scale(1.05)}
.widget-namaz-item .nm{display:block;font-size:.7rem;font-weight:700}
.widget-namaz-item .tm{display:block;font-size:.62rem;opacity:.85;margin-top:2px}
.widget-progress-line{width:100%;height:8px;background:#e5e7eb;border-radius:4px;overflow:hidden;margin-bottom:8px}
.widget-progress-fill{height:100%;background:linear-gradient(90deg,var(--primary-green),var(--accent-green));width:0;transition:width .5s}
.widget-countdown-text{font-size:.85rem;font-weight:700;color:var(--accent-green);text-align:center}
.widget-countdown-text .sec{color:#d97706}
.bottom-nav{position:fixed;bottom:0;width:100%;background:var(--card-bg);display:flex;justify-content:space-around;padding:12px 0 15px;border-top:1px solid #e5e7eb;z-index:1000;box-shadow:0 -2px 10px rgba(0,0,0,.05);border-top-left-radius:20px;border-top-right-radius:20px}
.nav-item{text-align:center;color:#9ca3af;font-size:.65rem;cursor:pointer;flex:1}
.nav-item i{font-size:1.1rem;display:block;margin-bottom:4px}
.nav-item.active{color:var(--primary-green);font-weight:700}
.admin-section{background:var(--card-bg);padding:15px;border-radius:var(--border-radius);box-shadow:var(--shadow);margin-bottom:15px;border-left:4px solid var(--accent-green)}
.admin-section h4{color:var(--primary-green);margin-bottom:10px;font-size:1rem;border-bottom:1px dashed #e5e7eb;padding-bottom:8px}
.admin-list-item{border-bottom:1px dashed #eee;padding:10px 0;display:flex;justify-content:space-between;align-items:flex-start;gap:10px}
.admin-list-info{flex:1;font-size:.85rem}
.menu-tree-item{background:var(--bg-color);padding:10px;border-radius:8px;margin-bottom:8px;border-left:4px solid var(--accent-green)}
.menu-tree-children{margin-top:8px;padding-left:15px;border-left:2px dashed #ccc}
.menu-tree-child{display:flex;justify-content:space-between;align-items:center;padding:6px 0;font-size:.85rem}
.amal-group{background:var(--card-bg);border-radius:14px;box-shadow:var(--shadow);margin-bottom:12px;overflow:hidden;border-left:4px solid var(--accent-green)}
.amal-group-header{display:flex;justify-content:space-between;align-items:center;padding:14px 15px;cursor:pointer}
.amal-group-header h4{color:var(--primary-green);font-size:.95rem;display:flex;align-items:center;gap:8px}
.amal-group-body{padding:5px 15px 15px;display:none}
.amal-group-body.open{display:block}
.amal-check-item{display:flex;align-items:center;gap:12px;padding:9px 0;border-bottom:1px solid var(--bg-color)}
.amal-check-item:last-child{border-bottom:none}
.amal-check-item input[type=checkbox]{width:20px;height:20px;accent-color:var(--accent-green);flex-shrink:0}
.amal-check-item label{font-size:.88rem;color:var(--text-dark);cursor:pointer;flex:1}
.report-tabs{display:flex;background:var(--bg-color);border-radius:10px;padding:4px;margin-bottom:12px;gap:4px}
.report-tab{flex:1;text-align:center;padding:8px 4px;border-radius:8px;font-size:.75rem;font-weight:600;cursor:pointer;color:#6b7280}
.report-tab.active{background:var(--card-bg);color:var(--primary-green);box-shadow:0 2px 4px rgba(0,0,0,.1)}
.report-stat-card{background:var(--bg-color);border-radius:12px;padding:15px;margin-bottom:10px;text-align:center}
.report-stat-card .value{font-size:1.8rem;font-weight:800;color:var(--primary-green)}
.report-stat-card .lbl{font-size:.8rem;color:#6b7280}
.report-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.cal-grid-7{display:grid;grid-template-columns:repeat(7,1fr);gap:4px}
.cal-head-cell{text-align:center;color:var(--accent-green);font-size:.72rem;font-weight:700;padding:6px 0}
.cal-day-cell{text-align:center;padding:8px 2px;border-radius:10px;background:var(--bg-color);font-weight:600;font-size:.9rem;color:var(--text-dark);line-height:1.2}
.cal-day-cell.today{background:linear-gradient(135deg,var(--primary-green),var(--accent-green));color:#fff;box-shadow:0 4px 10px rgba(5,150,105,.4)}
.cal-day-cell .hij{display:block;font-size:.6rem;opacity:.75;margin-top:2px;font-weight:500}
.cal-day-cell.today .hij{opacity:1;color:#d1fae5}
.social-links-box{background:linear-gradient(135deg,var(--primary-green),var(--accent-green));border-radius:16px;padding:18px;margin:18px 0 10px;color:#fff;text-align:center}
.social-links-box h4{font-size:1rem;margin-bottom:12px}
.social-links-grid{display:flex;justify-content:center;gap:12px;flex-wrap:wrap}
.social-link-btn{width:48px;height:48px;border-radius:50%;background:rgba(255,255,255,.2);color:#fff;display:flex;align-items:center;justify-content:center;font-size:1.25rem;text-decoration:none;border:1px solid rgba(255,255,255,.3)}
.login-hero{text-align:center;padding:30px 15px 20px;background:linear-gradient(135deg,var(--primary-green),var(--accent-green));color:#fff;margin:0 -20px 20px;border-bottom-left-radius:30px;border-bottom-right-radius:30px}
.login-hero img{width:90px;height:90px;border-radius:50%;border:3px solid #fff;background:#fff;margin-bottom:10px}
.login-hero h2{font-size:1.15rem;margin-bottom:5px}
.login-hero p{font-size:.85rem;opacity:.9}
.login-btn{display:flex;align-items:center;justify-content:center;gap:12px;padding:14px;border-radius:12px;border:none;font-size:.95rem;font-weight:600;cursor:pointer;width:100%;margin-bottom:10px;font-family:'Hind Siliguri',sans-serif}
.login-btn.google{background:#fff;color:#3c4043;border:1px solid #dadce0}
.login-btn.guest{background:var(--bg-color);color:var(--text-dark);border:1px solid #d1d5db}
.login-btn.primary{background:linear-gradient(135deg,var(--primary-green),var(--accent-green));color:#fff}
.auth-tabs{display:flex;background:var(--bg-color);border-radius:10px;padding:4px;margin-bottom:15px;gap:4px}
.auth-tab{flex:1;text-align:center;padding:9px;border-radius:8px;font-size:.85rem;font-weight:600;cursor:pointer;color:#6b7280}
.auth-tab.active{background:var(--card-bg);color:var(--primary-green);box-shadow:0 2px 4px rgba(0,0,0,.1)}
.person-card{background:var(--card-bg);border-radius:14px;box-shadow:var(--shadow);padding:14px;margin-bottom:12px;border-left:4px solid var(--accent-green);display:flex;gap:12px}
.person-card img{width:70px;height:70px;border-radius:50%;object-fit:cover;border:3px solid var(--light-green);flex-shrink:0}
.person-card-body{flex:1}
.person-card-body h4{color:var(--primary-green);font-size:1rem;margin-bottom:2px}
.person-card-body .role{font-size:.75rem;color:var(--accent-green);font-weight:700;margin-bottom:6px}
.person-card-body .bio{font-size:.85rem;color:var(--text-dark);line-height:1.5;margin-bottom:6px}
.person-card-body .meta{font-size:.75rem;color:#6b7280}
.gallery-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:6px}
.gallery-thumb{aspect-ratio:1;border-radius:10px;overflow:hidden;background:var(--bg-color);cursor:pointer;box-shadow:var(--shadow)}
.gallery-thumb img{width:100%;height:100%;object-fit:cover}
.gallery-lightbox{position:fixed;inset:0;background:rgba(0,0,0,.95);z-index:99999;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:15px}
.gallery-lightbox img{max-width:100%;max-height:75vh;border-radius:10px}
.gallery-lightbox .cap{color:#fff;text-align:center;margin-top:12px;font-size:.9rem}
.gallery-lightbox .close-btn{position:absolute;top:15px;right:15px;background:#dc2626;color:#fff;border:none;width:40px;height:40px;border-radius:50%;font-size:1.1rem;cursor:pointer}
.gallery-lightbox .nav-btn{position:absolute;top:50%;transform:translateY(-50%);background:rgba(255,255,255,.25);color:#fff;border:none;width:44px;height:44px;border-radius:50%;font-size:1.1rem;cursor:pointer}
.edu-card{background:var(--card-bg);border-radius:14px;box-shadow:var(--shadow);padding:16px;margin-bottom:12px;border-left:4px solid var(--accent-green);cursor:pointer}
.edu-card h4{color:var(--primary-green);font-size:1rem;margin-bottom:6px;display:flex;align-items:center;gap:8px}
.edu-card p{font-size:.85rem;color:var(--text-dark);line-height:1.5}
.contact-card{background:var(--card-bg);border-radius:14px;box-shadow:var(--shadow);padding:16px;margin-bottom:12px;display:flex;gap:14px;align-items:flex-start}
.contact-card .ico{width:48px;height:48px;border-radius:50%;background:var(--light-green);color:var(--primary-green);display:flex;align-items:center;justify-content:center;font-size:1.2rem;flex-shrink:0}
.contact-card .body{flex:1}
.contact-card .body h4{font-size:.9rem;color:var(--primary-green);margin-bottom:4px}
.contact-card .body p,.contact-card .body a{font-size:.88rem;color:var(--text-dark);text-decoration:none;line-height:1.5;word-break:break-word}
.notif-card{background:var(--card-bg);border-radius:14px;box-shadow:var(--shadow);padding:14px;margin-bottom:12px;border-left:4px solid var(--accent-green)}
.notif-card .badge{display:inline-block;background:var(--light-green);color:var(--primary-green);font-size:.7rem;font-weight:700;padding:2px 10px;border-radius:12px;margin-bottom:8px}
.notif-card h4{color:var(--primary-green);font-size:.95rem;margin-bottom:6px}
.notif-card .body{font-size:.85rem;line-height:1.6;color:var(--text-dark)}
.notif-card .body .ar{font-family:'Amiri',serif;font-size:1.15rem;direction:rtl;text-align:right;color:var(--primary-green);line-height:2;margin-bottom:8px}
.notif-card .ref{font-size:.72rem;color:#6b7280;font-style:italic;margin-top:6px}
.quran-surah-item{background:var(--card-bg);border-radius:12px;padding:12px 15px;margin-bottom:8px;box-shadow:var(--shadow);display:flex;justify-content:space-between;align-items:center;cursor:pointer;border-left:3px solid var(--accent-green)}
.quran-surah-item .left{flex:1}
.quran-surah-item .num{width:36px;height:36px;border-radius:50%;background:var(--light-green);color:var(--primary-green);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.85rem;flex-shrink:0;margin-right:12px}
.quran-surah-item .name-bn{font-weight:700;color:var(--primary-green);font-size:.95rem}
.quran-surah-item .name-ar{font-family:'Amiri',serif;font-size:1.05rem;color:var(--accent-green);direction:rtl}
.quran-surah-item .info{font-size:.72rem;color:#6b7280;margin-top:2px}
.ayah-card{background:var(--card-bg);border-radius:14px;padding:16px;margin-bottom:12px;box-shadow:var(--shadow);border-left:4px solid var(--accent-green)}
.ayah-card .num-badge{display:inline-block;background:var(--light-green);color:var(--primary-green);font-size:.72rem;font-weight:700;padding:2px 10px;border-radius:12px;margin-bottom:10px}
.ayah-card .ar{font-family:'Amiri',serif;font-size:1.6rem;direction:rtl;text-align:right;line-height:2.2;color:var(--primary-green);margin-bottom:12px}
.ayah-card .bn{font-size:.95rem;line-height:1.7;color:var(--text-dark)}
.mushaf-scroll{background:#fdf6e3;border-radius:14px;padding:20px;box-shadow:var(--shadow);max-height:70vh;overflow-y:auto;scroll-behavior:smooth}
body.dark-mode .mushaf-scroll{background:#1a1a1a}
.mushaf-scroll .ar{font-family:'Amiri',serif;font-size:1.7rem;direction:rtl;text-align:right;line-height:2.4;color:#1f2937}
body.dark-mode .mushaf-scroll .ar{color:#f3f4f6}
.mushaf-controls{display:flex;gap:8px;margin:12px 0;flex-wrap:wrap;align-items:center;background:var(--card-bg);padding:12px;border-radius:12px;box-shadow:var(--shadow)}
.mushaf-controls button{background:var(--primary-green);color:#fff;border:none;padding:8px 14px;border-radius:20px;font-size:.8rem;cursor:pointer;font-family:'Hind Siliguri',sans-serif}
.mushaf-controls button:disabled{opacity:.5}
.mushaf-controls input[type=range]{flex:1;min-width:100px;accent-color:var(--accent-green)}
.zakat-result{background:linear-gradient(135deg,var(--primary-green),var(--accent-green));color:#fff;border-radius:16px;padding:20px;margin-top:15px;text-align:center}
.zakat-result .big{font-size:2rem;font-weight:800;margin:8px 0}
.zakat-result .lbl{font-size:.85rem;opacity:.9}
.zakat-result .row{display:flex;justify-content:space-between;padding:6px 0;font-size:.85rem;border-bottom:1px solid rgba(255,255,255,.15)}
.age-result{background:linear-gradient(135deg,var(--primary-green),var(--accent-green));color:#fff;border-radius:16px;padding:20px;margin-top:15px;text-align:center}
.age-result .big{font-size:1.6rem;font-weight:800;margin:10px 0}
.age-result .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:12px}
.age-result .item{background:rgba(255,255,255,.15);border-radius:10px;padding:10px 5px}
.age-result .item .v{font-size:1.4rem;font-weight:800}
.age-result .item .l{font-size:.7rem;opacity:.9}
.compass-wrap{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:25px 15px;background:var(--card-bg);border-radius:20px;box-shadow:var(--shadow)}
.compass-circle{width:260px;height:260px;border-radius:50%;border:5px solid var(--primary-green);position:relative;background:radial-gradient(circle,var(--bg-color),var(--card-bg));box-shadow:inset 0 0 30px rgba(0,0,0,.1);margin:15px 0}
.compass-circle .dir{position:absolute;font-weight:800;color:var(--primary-green);font-size:1rem}
.compass-circle .dir.n{top:8px;left:50%;transform:translateX(-50%)}
.compass-circle .dir.s{bottom:8px;left:50%;transform:translateX(-50%)}
.compass-circle .dir.e{right:8px;top:50%;transform:translateY(-50%)}
.compass-circle .dir.w{left:8px;top:50%;transform:translateY(-50%)}
.compass-needle{position:absolute;top:50%;left:50%;width:6px;height:110px;margin-left:-3px;transform-origin:50% 100%;background:linear-gradient(to bottom,#10b981 0%,#10b981 50%,#dc2626 50%,#dc2626 100%);border-radius:3px;box-shadow:0 0 6px rgba(0,0,0,.3)}
.compass-kaaba{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:44px;height:44px;background:var(--primary-green);color:#fff;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.2rem;box-shadow:0 4px 10px rgba(0,0,0,.25);z-index:5}
.compass-info{margin-top:15px;font-size:.85rem;color:var(--text-dark);text-align:center;line-height:1.6}
.compass-qibla-arrow{position:absolute;top:50%;left:50%;width:4px;height:110px;margin-left:-2px;transform-origin:50% 100%;background:#f59e0b;border-radius:2px;box-shadow:0 0 8px #f59e0b}
.user-menu-pop{position:fixed;top:90px;right:15px;background:var(--card-bg);border-radius:14px;box-shadow:var(--shadow-lg);padding:12px;z-index:9999;min-width:200px;border:1px solid var(--light-green)}
.user-menu-pop .uinfo{padding:8px 10px;border-bottom:1px solid var(--bg-color);margin-bottom:8px}
.user-menu-pop .uinfo .un{font-weight:700;color:var(--primary-green);font-size:.9rem}
.user-menu-pop .uinfo .ue{font-size:.72rem;color:#6b7280;word-break:break-all}
.user-menu-pop button{width:100%;background:transparent;border:none;padding:10px;text-align:left;border-radius:8px;font-size:.85rem;color:var(--text-dark);cursor:pointer;font-family:'Hind Siliguri',sans-serif}
.user-menu-pop button:hover{background:var(--bg-color)}
.user-menu-pop button.danger{color:#dc2626}
</style>
