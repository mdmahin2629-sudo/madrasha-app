images.forEach((img, idx) => {
html += `<div class="gallery-thumb" onclick="openGalleryLightbox(${idx})"><img src="${img.url}" onerror="this.src='https://cdn-icons-png.flaticon.com/512/3299/3299935.png'"></div>`;
});
html += '</div>';
c.innerHTML = html;
}
switchPage('menu-detail-page');
});
