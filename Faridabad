function getTodayKey() {
const d = new Date();
return d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0');
}

function toggleAmalGroup(id) {
const b = document.getElementById(id);
const a = document.getElementById('arrow_' + id);
if(b) {
const open = b.classList.toggle('open');
if(a) a.style.transform = open ? 'rotate(180deg)' : 'rotate(0deg)';
}
}

async function saveAmalToday() {
const cbs = document.querySelectorAll('.amal-cb');
const checked = [];
cbs.forEach(cb => { if(cb.checked) checked.push(cb.id); });
const today = getTodayKey();
amalHistory[today] = { checked, total: cbs.length, timestamp: Date.now() };
await saveUserAmal();
updateAmalProgress(checked.length, cbs.length);
renderReport();
}

function loadAmalToday() {
const cbs = document.querySelectorAll('.amal-cb');
const today = getTodayKey();
const todayData = amalHistory[today] || { checked: [] };
cbs.forEach(cb => { cb.checked = todayData.checked.includes(cb.id); });
updateAmalProgress(todayData.checked.length, cbs.length);
}

function updateAmalProgress(done, total) {
if(total === undefined) {
const cbs = document.querySelectorAll('.amal-cb');
total = cbs.length;
done = 0;
cbs.forEach(cb => { if(cb.checked) done++; });
}
const pct = total > 0 ? (done / total) * 100 : 0;
const pb = document.getElementById('amalProgressBar');
const pt = document.getElementById('amalProgressText');
if(pb) pb.style.width = pct + '%';
if(pt) pt.innerText = `${toBn(done)} / ${toBn(total)} আমল সম্পন্ন (${toBn(Math.round(pct))}%)`;
}

function switchReport(type, btn) {
currentReport = type;
document.querySelectorAll('.report-tab').forEach(t => t.classList.remove('active'));
if(btn) btn.classList.add('active');
renderReport();
}

function renderReport() {
const c = document.getElementById('reportContent');
if(!c) return;
const today = new Date();
let days = 1, title = 'আজকের রিপোর্ট';
if(currentReport === 'weekly') { days = 7; title = 'শেষ ৭ দিনের রিপোর্ট'; }
else if(currentReport === 'monthly') { days = 30; title = 'শেষ ৩০ দিনের রিপোর্ট'; }
else if(currentReport === 'yearly') { days = 365; title = 'শেষ ৩৬৫ দিনের রিপোর্ট'; }

let totalDone = 0, totalPossible = 0, daysWithData = 0;
const totalAmal = AMAL_GROUPS.reduce((s, g) => s + g.items.length, 0);
for(let i = 0; i < days; i++) {
const d = new Date(today);
d.setDate(d.getDate() - i);
const key = d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0');
if(amalHistory[key]) {
totalDone += amalHistory[key].checked.length;
totalPossible += amalHistory[key].total;
daysWithData++;
} else totalPossible += totalAmal;
}
const pct = totalPossible > 0 ? Math.round((totalDone / totalPossible) * 100) : 0;

c.innerHTML = `<h4 style="color:var(--primary-green);margin-bottom:10px;text-align:center;">${title}</h4>
<div class="report-stat-card"><div class="value">${toBn(pct)}%</div><div class="lbl">সামগ্রিক সম্পন্নতা</div></div>
<div class="report-grid">
<div class="report-stat-card"><div class="value">${toBn(totalDone)}</div><div class="lbl">আমল সম্পন্ন</div></div>
<div class="report-stat-card"><div class="value">${toBn(daysWithData)}</div><div class="lbl">দিনের ডেটা</div></div>
</div>
${daysWithData === 0 ? '<p style="text-align:center;color:#6b7280;margin-top:10px;font-size:.85rem;">এখনো কোনো ডেটা নেই।</p>' : ''}`;
}

/* ============ CHAT ============ */
function verifyAndShowChat() {
const n = document.getElementById('msgSenderName').value.trim();
const r = document.getElementById('msgSenderRoll').value.trim();
if(!n || !r) return alert('নাম এবং দাখেলা দিন!');
currentChatUser = { name: n, roll: r };
document.getElementById('messageFormBox').classList.add('hidden');
document.getElementById('chatBox').classList.remove('hidden');
loadMessages();
}
function loadMessages() {
db.ref('messages').on('value', (snap) => {
const data = snap.val() || {};
const c = document.getElementById('chatMessages');
if(!c) return;
c.innerHTML = '';
let has = false;
Object.values(data).forEach(msg => {
has = true;
const isMe = currentChatUser && msg.senderName === currentChatUser.name && msg.senderRoll === currentChatUser.roll;
const div = document.createElement('div');
div.style.cssText = `max-width:80%;padding:10px 14px;border-radius:12px;font-size:.9rem;${isMe ? 'background:var(--accent-green);color:#fff;align-self:flex-end;' : 'background:#e5e7eb;color:#1f2937;align-self:flex-start;'}`;
div.innerHTML = `<span style="font-size:.7rem;font-weight:600;opacity:.8;">${msg.senderName} (${msg.senderRoll})</span><br>${msg.text}`;
c.appendChild(div);
});
if(!has) c.innerHTML = '<p style="text-align:center;color:#6b7280;">কোনো মেসেজ নেই।</p>';
c.scrollTop = c.scrollHeight;
});
}
function sendMessage() {
if(!currentChatUser) return alert('লগইন করুন।');
const inp = document.getElementById('chatInput');
const text = inp.value.trim();
if(!text) return;
db.ref('messages').push({ text, senderName: currentChatUser.name, senderRoll: currentChatUser.roll, timestamp: Date.now() });
inp.value = '';
}

