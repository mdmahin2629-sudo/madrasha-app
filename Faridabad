/* ============ ZAKAT CALCULATOR ============ */
function calcZakat() {
const cash = parseFloat(document.getElementById('zk_cash').value) || 0;
const bank = parseFloat(document.getElementById('zk_bank').value) || 0;
const goldG = parseFloat(document.getElementById('zk_gold_g').value) || 0;
const goldR = parseFloat(document.getElementById('zk_gold_rate').value) || 0;
const silverG = parseFloat(document.getElementById('zk_silver_g').value) || 0;
const silverR = parseFloat(document.getElementById('zk_silver_rate').value) || 0;
const biz = parseFloat(document.getElementById('zk_business').value) || 0;
const rec = parseFloat(document.getElementById('zk_receivable').value) || 0;
const oth = parseFloat(document.getElementById('zk_other').value) || 0;
const lia = parseFloat(document.getElementById('zk_liability').value) || 0;
const nisabType = document.getElementById('zk_nisab_type').value;

const goldVal = goldG * goldR;
const silverVal = silverG * silverR;
const totalAssets = cash + bank + goldVal + silverVal + biz + rec + oth;
const netAssets = totalAssets - lia;

// Nisab: gold 87.48g, silver 612.36g
// approximate nisab value using silver rate, or gold rate if silver unknown
let nisabValue = 0;
if(nisabType === 'silver') {
const sr = silverR || (goldR ? goldR / 90 : 0);
nisabValue = sr * 612.36;
} else {
const gr = goldR || (silverR ? silverR * 90 : 0);
nisabValue = gr * 87.48;
}

const eligible = netAssets >= nisabValue && netAssets > 0;
const zakat = eligible ? netAssets * 0.025 : 0;

const c = document.getElementById('zakatResult');
c.innerHTML = `<div class="zakat-result">
<div class="lbl">মোট সম্পদ</div><div class="big">৳ ${toBn(Math.round(totalAssets).toLocaleString('en-US'))}</div>
<div class="row"><span>প্রযোজ্য দায়</span><span>৳ ${toBn(Math.round(lia).toLocaleString('en-US'))}</span></div>
<div class="row"><span>নিট যাকাতযোগ্য সম্পদ</span><span>৳ ${toBn(Math.round(netAssets).toLocaleString('en-US'))}</span></div>
<div class="row"><span>নিসাব ${nisabType === 'silver' ? '(রুপা)' : '(স্বর্ণ)'}</span><span>৳ ${toBn(Math.round(nisabValue).toLocaleString('en-US'))}</span></div>
<div class="row"><span>নিসাব পূরণ</span><span>${eligible ? '✅ হ্যাঁ' : '❌ না'}</span></div>
<div class="row"><span>যাকাতের হার</span><span>২.৫%</span></div>
</div>
${eligible ? `<div class="zakat-result" style="margin-top:10px;"><div class="lbl">প্রদেয় যাকাত</div><div class="big">৳ ${toBn(Math.round(zakat).toLocaleString('en-US'))}</div></div>` : '<div class="form-box text-center" style="margin-top:10px;"><p style="color:#6b7280;">নিসাব পূরণ হয়নি — যাকাত ফরজ নয়।</p></div>'}`;
}

/* ============ AGE CALCULATOR ============ */
function calcAge() {
const bd = document.getElementById('birthDate').value;
if(!bd) return alert('জন্ম তারিখ দিন');
const birth = new Date(bd);
const today = new Date();
if(birth > today) return alert('ভবিষ্যতের তারিখ গ্রহণযোগ্য নয়');

let years = today.getFullYear() - birth.getFullYear();
let months = today.getMonth() - birth.getMonth();
let days = today.getDate() - birth.getDate();
if(days < 0) { months--; days += new Date(today.getFullYear(), today.getMonth(), 0).getDate(); }
if(months < 0) { years--; months += 12; }

const nextBd = new Date(today.getFullYear(), birth.getMonth(), birth.getDate());
if(nextBd < today) nextBd.setFullYear(nextBd.getFullYear() + 1);
const diffDays = Math.ceil((nextBd - today) / 86400000);

const totalDays = Math.floor((today - birth) / 86400000);

document.getElementById('ageResult').innerHTML = `<div class="age-result">
