/* ============ NOTES ============ */
async function saveNote() {
const t = document.getElementById('noteInput').value.trim();
if(!t) return;
notes.push({ text: t, date: new Date().toLocaleString('bn-BD') });
await saveUserNotes();
renderNotes();
document.getElementById('noteInput').value = '';
}
function renderNotes() {
const l = document.getElementById('noteList');
if(!l) return;
if(notes.length === 0) { l.innerHTML = '<p style="text-align:center;color:#6b7280;">কোনো নোট নেই।</p>'; return; }
l.innerHTML = notes.slice().reverse().map((n, i) => `<div style="border-bottom:1px solid var(--bg-color);padding:8px 0;"><p>${n.text}</p><small style="color:#6b7280;">${n.date}</small><button class="btn-primary btn-sm btn-danger" style="float:right;margin-top:-20px;" onclick="deleteNote(${notes.length - 1 - i})">ডিলিট</button></div>`).join('');
}
async function deleteNote(i) { notes.splice(i, 1); await saveUserNotes(); renderNotes(); }

/* ============ CALCULATOR ============ */
let calcCurrent = '';
function calcAppend(v) { if(calcCurrent === '0' && v !== '.') calcCurrent = ''; calcCurrent += v; document.getElementById('calcDisplay').innerText = calcCurrent; }
function calcClear() { calcCurrent = ''; document.getElementById('calcDisplay').innerText = '0'; }
function calcBackspace() { calcCurrent = calcCurrent.slice(0, -1); document.getElementById('calcDisplay').innerText = calcCurrent || '0'; }
function calcEvaluate() { try { let r = eval(calcCurrent); if(r === undefined) r = 0; calcCurrent = r.toString(); document.getElementById('calcDisplay').innerText = calcCurrent; } catch(e) { document.getElementById('calcDisplay').innerText = 'Error'; calcCurrent = ''; } }

