/* ============ COMPASS (Real GPS + Sensor) ============ */
function enableCompass() {
if(typeof DeviceOrientationEvent !== 'undefined' && typeof DeviceOrientationEvent.requestPermission === 'function') {
DeviceOrientationEvent.requestPermission().then(p => { if(p === 'granted') startCompass(); else alert('সেন্সর অনুমতি প্রয়োজন'); });
} else startCompass();
}

async function startCompass() {
compassActive = true;
document.getElementById('enableCompassBtn').style.display = 'none';
document.getElementById('compassCircle').style.display = 'block';

// Get location for qibla
if(navigator.geolocation) {
navigator.geolocation.getCurrentPosition(
(pos) => {
currentLat = pos.coords.latitude;
currentLon = pos.coords.longitude;
currentQiblaBearing = calcQiblaBearing(currentLat, currentLon);
updateCompassUI();
},
() => {
currentQiblaBearing = calcQiblaBearing(23.7104, 90.4125);
updateCompassUI();
},
{ enableHighAccuracy: true, timeout: 10000 }
);
} else {
currentQiblaBearing = calcQiblaBearing(23.7104, 90.4125);
updateCompassUI();
}

window.addEventListener('deviceorientationabsolute', handleOrientation, true);
window.addEventListener('deviceorientation', handleOrientation, true);
}

function handleOrientation(e) {
let heading = 0;
if(e.webkitCompassHeading) heading = e.webkitCompassHeading;
else if(e.alpha !== null) heading = 360 - e.alpha;
deviceHeading = heading;
updateCompassUI();
}

function calcQiblaBearing(lat, lon) {
const kaabaLat = 21.4225, kaabaLon = 39.8262;
const φ1 = lat * Math.PI / 180;
const φ2 = kaabaLat * Math.PI / 180;
const Δλ = (kaabaLon - lon) * Math.PI / 180;
const x = Math.sin(Δλ) * Math.cos(φ2);
const y = Math.cos(φ1) * Math.sin(φ2) - Math.sin(φ1) * Math.cos(φ2) * Math.cos(Δλ);
const θ = Math.atan2(x, y) * 180 / Math.PI;
return (θ + 360) % 360;
}

function updateCompassUI() {
const circle = document.getElementById('compassCircle');
if(!circle || !compassActive) return;
const need = document.getElementById('compassNeedle');
const qibla = document.getElementById('qiblaArrow');
const deg = document.getElementById('compassDegree');
const info = document.getElementById('qiblaInfo');
if(need) need.style.transform = `rotate(${-deviceHeading}deg)`;
if(qibla) qibla.style.transform = `rotate(${currentQiblaBearing - deviceHeading}deg)`;
if(deg) deg.innerText = `${toBn(Math.round(deviceHeading))}°`;
if(info) {
const diff = ((currentQiblaBearing - deviceHeading) + 360) % 360;
const dir = diff < 5 || diff > 355 ? '✅ কিবলার দিকে মুখ করে আছেন' : (diff < 180 ? `ডান দিকে ${toBn(Math.round(diff))}°` : `বাম দিকে ${toBn(Math.round(360 - diff))}°`);
info.innerHTML = `কিবলার দিক: ${toBn(Math.round(currentQiblaBearing))}°<br>${dir}`;
}
}

/* ============ LOCATION + NAMAZ ============ */
function fetchLocationAndUpdateNamaz() {
const t = document.getElementById('locationText');
if(navigator.geolocation) {
navigator.geolocation.getCurrentPosition(
(pos) => {
currentLat = pos.coords.latitude;
currentLon = pos.coords.longitude;
updateNamazTimes(currentLat, currentLon);
if(t) t.innerText = `অবস্থান: ${currentLat.toFixed(4)}, ${currentLon.toFixed(4)}`;
},
() => { if(t) t.innerText = 'লোকেশন পারমিশন নেই।'; },
{ enableHighAccuracy: true, timeout: 10000 }
);
}
}
function updateNamazTimes(lat, lon) {
const off = (90 - lon) * 4;
const base = { fajr: '৪:৪৫', sunrise: '৬:০০', dhuhr: '১২:০৫', asr: '৪:১৫', maghrib: '৫:৫০', isha: '৭:০৫' };
const adj = (t, o) => {
const eng = t.replace(/[০-৯]/g, d => '০১২৩৪৫৬৭৮৯'.indexOf(d));
const [h, m] = eng.split(':').map(Number);
let tot = h * 60 + m + Math.round(o);
if(tot < 0) tot += 1440;
if(tot >= 1440) tot -= 1440;
return `${toBn(Math.floor(tot/60))}:${toBn((tot%60).toString().padStart(2,'0'))}`;
};
const el = (id) => document.getElementById(id);
if(el('fajrTime')) el('fajrTime').innerText = `${adj(base.fajr, off)} - ${adj(base.sunrise, off)}`;
if(el('sunriseTime')) el('sunriseTime').innerText = adj(base.sunrise, off);
if(el('dhuhrTime')) el('dhuhrTime').innerText = `${adj(base.dhuhr, off)} - ${adj(base.asr, off)}`;
if(el('asrTime')) el('asrTime').innerText = `${adj(base.asr, off)} - ${adj(base.maghrib, off)}`;
if(el('maghribTime')) el('maghribTime').innerText = `${adj(base.maghrib, off)} - ${adj(base.isha, off)}`;
if(el('ishaTime')) el('ishaTime').innerText = `${adj(base.isha, off)} - ${adj('৪:৪৫', off)}`;
if(el('sunsetTime')) el('sunsetTime').innerText = adj(base.maghrib, off);
}

/* ============ AMAL TRACKER ============ */
function renderAmalGroups() {
const c = document.getElementById('amalGroupsContainer');
if(!c || c.dataset.rendered === '1') return;
c.dataset.rendered = '1';
c.innerHTML = AMAL_GROUPS.map((g, i) => `
