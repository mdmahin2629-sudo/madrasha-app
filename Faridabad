/* ============ WIDGET ============ */
function startNamazWidget() {
setInterval(() => {
const now = new Date();
const monthsBn = ['জানুয়ারি','ফেব্রুয়ারি','মার্চ','এপ্রিল','মে','জুন','জুলাই','আগস্ট','সেপ্টেম্বর','অক্টোবর','নভেম্বর','ডিসেম্বর'];
const wdb = document.getElementById('widgetDateBn');
if(wdb) wdb.innerText = `${toBn(now.getDate())} ${monthsBn[now.getMonth()]} ${toBn(now.getFullYear())}`;
const h = getHijriDate(now);
const wda = document.getElementById('widgetDateAr');
if(wda) wda.innerText = `${toBn(h.day)} ${h.monthBn} ${toBn(h.year)}`;

const parse = (t) => {
if(!t) return null;
let b = t.replace(/[০-৯]/g, d => '০১২৩৪৫৬৭৮৯'.indexOf(d)).replace(/[^\d:]/g, '');
const m = b.match(/(\d{1,2}):(\d{2})/);
if(!m) return null;
let hh = parseInt(m[1]), mm = parseInt(m[2]);
if(hh >= 1 && hh <= 6) hh += 12;
return hh * 60 + mm;
};
const nowMin = now.getHours() * 60 + now.getMinutes();
const nowSec = now.getSeconds();
const sched = NAMAZ_ORDER.map(k => ({ key: k, start: parse(namazTimesToday[k]) })).filter(s => s.start !== null).sort((a,b) => a.start - b.start);
if(sched.length === 0) return;
let cur = null;
for(let i = 0; i < sched.length; i++) {
const st = sched[i].start;
const nx = (i+1 < sched.length) ? sched[i+1].start : sched[0].start + 1440;
if(nowMin >= st && nowMin < nx) { cur = { ...sched[i], end: nx }; break; }
}
if(!cur) {
const last = sched[sched.length - 1], first = sched[0];
if(nowMin < first.start) cur = { key: last.key, start: last.start - 1440, end: first.start };
}
if(!cur) return;
document.querySelectorAll('.widget-namaz-item').forEach(el => el.classList.toggle('active', el.dataset.namaz === cur.key));
const total = (cur.end - cur.start) * 60;
const elapsed = ((nowMin - cur.start) * 60) + nowSec;
const pct = Math.max(0, Math.min(100, (elapsed / total) * 100));
const fill = document.getElementById('widgetProgressFill');
if(fill) fill.style.width = pct + '%';
const remain = total - elapsed;
const hh = Math.floor(remain / 3600), mm = Math.floor((remain % 3600) / 60), ss = remain % 60;
const ct = document.getElementById('widgetCountdownText');
if(ct) {
let txt = `⏳ <strong>${NAMAZ_BN[cur.key]}</strong> ওয়াক্ত চলছে — বাকি `;
if(hh > 0) txt += `${toBn(hh)} ঘন্টা `;
txt += `${toBn(mm)} মিনিট <span class="sec">${toBn(ss.toString().padStart(2,'0'))} সেকেন্ড</span>`;
ct.innerHTML = txt;
}
}, 1000);
}

/* ============ HIJRI ============ */
function getHijriDate(date) {
const jd = Math.floor((date.getTime() / 86400000) + 2440587.5);
const l = jd - 1948440 + 10632;
const n = Math.floor((l - 1) / 10631);
const l2 = l - 10631 * n + 354;
const j = Math.floor((10985 - l2) / 5316) * Math.floor((50 * l2) / 17719) + Math.floor(l2 / 5670) * Math.floor((43 * l2) / 15238);
const l3 = l2 - Math.floor((30 - j) / 15) * Math.floor((17719 * j) / 50) - Math.floor(j / 16) * Math.floor((15238 * j) / 43) + 29;
const month = Math.floor((24 * l3) / 709);
const day = l3 - Math.floor((709 * month) / 24);
const year = 30 * n + j - 30;
const monthsBn = ['মুহাররম','সফর','রবিউল আউয়াল','রবিউস সানি','জমাদিউল আউয়াল','জমাদিউস সানি','রজব','শাবান','রমজান','শাওয়াল','জিলক্বদ','জিলহজ'];
return { day, monthBn: monthsBn[month - 1] || 'মুহাররম', year };
}

/* ============ CALENDAR ============ */
let currentMonth = new Date().getMonth(), currentYear = new Date().getFullYear();
const monthsBn = ['জানুয়ারি','ফেব্রুয়ারি','মার্চ','এপ্রিল','মে','জুন','জুলাই','আগস্ট','সেপ্টেম্বর','অক্টোবর','নভেম্বর','ডিসেম্বর'];
const daysBn = ['রবি','সোম','মঙ্গল','বুধ','বৃহস্পতি','শুক্র','শনি'];

function renderCalendar() {
const firstDay = new Date(currentYear, currentMonth, 1).getDay();
const daysInMonth = new Date(currentYear, currentMonth + 1, 0).getDate();
const today = new Date();
const cmy = document.getElementById('calendarMonthYear');
if(cmy) cmy.innerText = `${monthsBn[currentMonth]} ${toBn(currentYear)}`;
const grid = document.getElementById('calendarGrid');
if(!grid) return;
grid.innerHTML = '';
daysBn.forEach(d => grid.innerHTML += `<div class="cal-head-cell">${d}</div>`);
for(let i = 0; i < firstDay; i++) grid.innerHTML += '<div></div>';
for(let d = 1; d <= daysInMonth; d++) {
const dt = new Date(currentYear, currentMonth, d);
const hj = getHijriDate(dt);
const isToday = d === today.getDate() && currentMonth === today.getMonth() && currentYear === today.getFullYear();
grid.innerHTML += `<div class="cal-day-cell ${isToday ? 'today' : ''}">${toBn(d)}<span class="hij">${toBn(hj.day)}</span></div>`;
}
const hdd = document.getElementById('hijriDateDisplay');
const hjNow = getHijriDate(today);
if(hdd) hdd.innerText = `আজ: ${toBn(hjNow.day)} ${hjNow.monthBn} ${toBn(hjNow.year)} হি.`;
}
function changeMonth(dir) {
currentMonth += dir;
if(currentMonth > 11) { currentMonth = 0; currentYear++; }
if(currentMonth < 0) { currentMonth = 11; currentYear--; }
renderCalendar();
}

